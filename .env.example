# Template only; inject production secrets through the hosting dashboard.
NODE_ENV=production
PORT=3000
ALLOWED_HOSTS=localhost;127.0.0.1;[::1]
# Set to the verified real HTTPS domain before launch. Blank disables indexing.
PUBLIC_ORIGIN=
TRUSTED_PROXY_IPS=
INQUIRY_MODE=Disabled
INQUIRY_TIMEOUT_SECONDS=15
INQUIRY_RATE_LIMIT=5
INQUIRY_PUBLIC_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_RECIPIENT=

# P2.1 opt-in identity foundation. No private .env is loaded implicitly.
MANAGEMENT_ENABLED=false
MANAGEMENT_ORIGIN=
MANAGEMENT_LOCAL_HTTP=false
SESSION_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=upms_dev
DB_USER=
DB_PASSWORD=
# Required only for explicit local migration/bootstrap commands; exact DB_NAME.
DB_CONFIRM_NAME=
# Compatibility testing only; MariaDB does not satisfy real-MySQL acceptance.
DB_ALLOW_MARIADB_COMPATIBILITY=false
