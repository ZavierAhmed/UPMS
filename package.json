{
  "name": "upms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.0"
  },
  "scripts": {
    "install:all": "npm ci && npm ci --prefix upms.client",
    "build": "npm run build --prefix upms.client",
    "build:hosting": "npm ci --include=dev --prefix upms.client && npm run build",
    "package:deployment": "npm run build && node scripts/package-deployment.mjs",
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "test:backend": "node --test server/tests/*.test.js",
    "test:frontend": "npm test --prefix upms.client",
    "test:parity": "node server/tests/parity.mjs",
    "test:browser": "node server/tests/verify-browser.mjs",
    "test:browser:w06": "node server/tests/verify-browser.mjs --milestone=W06",
    "test:package": "node server/tests/verify-package.mjs",
    "verify": "npm run build && npm run test:backend && npm run test:frontend && npm run lint --prefix upms.client",
    "identity:inspect": "node server/tools/identity.mjs inspect",
    "identity:migrate": "node server/tools/identity.mjs migrate",
    "identity:bootstrap": "node server/tools/identity.mjs bootstrap",
    "test:mysql": "node --test server/tests/mysql/identity.integration.js",
    "identity:benchmark": "node server/tools/identity.mjs benchmark",
    "database:preflight": "node server/tools/database-preflight.mjs",
    "dev:remote": "node server/tools/remote-development.mjs start",
    "database:remote:preflight": "node server/tools/remote-development.mjs preflight",
    "dev:remote:login": "node server/tools/remote-login.mjs --allow-plaintext-auth-only"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "csrf-sync": "^4.2.1",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.15.0",
    "supertest": "^7.1.4"
  }
}
