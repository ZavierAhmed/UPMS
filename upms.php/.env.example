APP_NAME="Unique Plastic Industry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.unique-plastic.com
LOG_CHANNEL=single
LOG_LEVEL=warning
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
# Disabled by default. This milestone only accepts isolated local test schemas.
UPMS_ENABLED=false
UPMS_ORIGIN=https://app.unique-plastic.com
UPMS_DB_HOST=127.0.0.1
UPMS_DB_PORT=3328
UPMS_DB_DATABASE=upms_test_php_REPLACE
UPMS_DB_USERNAME=
UPMS_DB_PASSWORD=

# Public inquiries use a separate origin and private file journal, never SQL tables.
INQUIRY_ORIGIN=https://unique-plastic.com
INQUIRY_STORAGE=
INQUIRY_MODE=Disabled
INQUIRY_RATE_LIMIT=5
INQUIRY_TIMEOUT_SECONDS=15
# Absolute matching CLI executable when FPM's directory contains no php CLI.
INQUIRY_PHP_BINARY=
INQUIRY_SMTP_HOST=
INQUIRY_SMTP_PORT=587
INQUIRY_SMTP_TLS=StartTls
INQUIRY_SMTP_USERNAME=
INQUIRY_SMTP_PASSWORD=
INQUIRY_SMTP_FROM=
INQUIRY_SMTP_RECIPIENT=
# Optional trusted CA bundle; peer and hostname verification remain mandatory.
INQUIRY_SMTP_CAFILE=
